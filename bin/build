#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

cd $scriptdir/..

# A .env in the checkout holds tokens, Logline's admin token above all, and COPY would bake it
# into the image: the build stops until it is moved out
for env_file in .env logline/.env logline/lines/.env; do
    if [ -f "$env_file" ]; then
        echo "bin/build: $env_file is in the checkout and would go into the image — move it out, then build" >&2
        exit 1
    fi
done

# The commit the image is built from, for the page's header beside the version, with a + when
# the checkout has changes not committed; none outside a git checkout
commit=`git rev-parse --short=7 HEAD 2>/dev/null || true`
if [ -n "$commit" ] && [ -n "`git status --porcelain --untracked-files=no 2>/dev/null`" ]; then
    commit="$commit+"
fi

# --pull: the base images are fetched again rather than taken from the cache, so tailscale and
# node are the newest of their channels each time
docker build --pull --build-arg SERVICEMAN_COMMIT="$commit" -t serviceman .
