#!/bin/bash

# http://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# http://redsymbol.net/articles/unofficial-bash-strict-mode
set -o nounset -o errexit -o pipefail

script=`realpath $0`
scriptdir=`dirname $script`
scriptname=`basename $script`

RED="\e[31m"
GREEN="\e[32m"
RESET="\e[0m"

EXIT_MESSAGE="${RED}bin/release failed${RESET}"
trap 'echo -e $EXIT_MESSAGE' EXIT

cd $scriptdir/..

case "${1-}"  in
major|minor|patch)
    ;;
*)
    echo usage: release 'major|minor|patch' >&2
    exit 1
    ;;
esac

if test -n "`git status -s`"; then
    echo error: there are changes >&2
    exit 1
fi

# The branch the release is made on. It and the release's own tag are what is pushed, and
# nothing else this machine holds: no other branch, no other tag
branch=`git symbolic-ref --short HEAD`
remote=`git config branch.$branch.remote || echo origin`

# Everything the project checks itself with, before anything is written
npm run lint
bin/test
node --test modules/*/tests/*.test.js
(cd logline/lines && bin/test)

# Increase a version without commiting it and making a tag
npm version $1 --no-git-tag-version

# The release says itself on top of the changelog, above the changes it gathers
version=`node -e 'console.log(require("./package.json").version)'`
node -e '
const fs = require("fs");
const text = fs.readFileSync("CHANGELOG.md", "utf8");
const at = text.indexOf("\n## ") + 1;
fs.writeFileSync("CHANGELOG.md", `${text.slice(0, at)}## ${process.argv[1]} — ${process.argv[2]}\n\n- Released.\n\n${text.slice(at)}`);
' "$version" "`date +%F`"

# The agent file is not kept in the repository: a machine takes it from the host it dials,
# /api/v1/agent.js, built from source there
git add package.json CHANGELOG.md
if test -e package-lock.json; then
    git add package-lock.json
fi

git commit -m "release: v$version"

# Create a tag
git tag v$version

git push $remote $branch v$version

EXIT_MESSAGE="${GREEN}bin/release succeeded${RESET}"
