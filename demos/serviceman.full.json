{
    "listen": {"host": "127.0.0.1", "port": 8080},
    "control": {"host": "serviceman.localhost", "port": 8081, "bind": "127.0.0.1"},
    "defaults": {
        "start": "on_demand",
        "stop_after_idle": "10m",
        "start_timeout": "120s"
    },
    "remotes": [
        {"name": "vps1", "title": "Example VPS", "token": "replace-me-with-openssl-rand-hex-32", "tags": ["eu"]}
    ],
    "services": [
        {
            "name": "grafana",
            "title": "Grafana",
            "type": "docker",
            "remote": "vps1",
            "publish": {"host": "grafana.example.com", "port": 3000},
            "image": "grafana/grafana:latest",
            "env": {"GF_SERVER_ROOT_URL": "https://grafana.example.com"},
            "volumes": [
                "grafana-data:/var/lib/grafana",
                {"source": "./grafana/provisioning", "target": "/etc/grafana/provisioning", "readonly": true}
            ],
            "network": "backend",
            "run_args": ["--memory", "512m"],
            "args": [],
            "policy": {"start": "on_demand", "stop_after_idle": "30m", "start_timeout": "90s"}
        },
        {
            "name": "demo",
            "title": "Sales demo",
            "type": "docker",
            "remotes": ["vps1", "#eu"],
            "publish": {"host": "demo.example.com", "port": 8080},
            "image": "demo/app:2026-08",
            "policy": {"start": "on_demand", "stop_after_idle": false}
        },
        {
            "name": "rockpool",
            "title": "Terminals",
            "type": "external",
            "publish": {"host": "terminals.example.com"},
            "upstream": "127.0.0.1:7000"
        },
        {
            "name": "clickhouse-socket",
            "title": "ClickHouse on a socket",
            "type": "shell",
            "remote": "vps1",
            "command": "socat UNIX-LISTEN:/srv/clickhouse.sock,fork,unlink-early,mode=666 TCP:127.0.0.1:8123",
            "policy": {"start": "always", "restart": "always"}
        },
        {
            "name": "pdf",
            "title": "PDF maker",
            "type": "docker",
            "remotes": ["#eu"],
            "publish": {"host": "tools.example.com/pdf", "port": 3000, "strip_prefix": true},
            "image": "demo/pdf:latest",
            "policy": {
                "instances": {"min": 1, "max": 3},
                "concurrency": 2,
                "warmup": {"queue": 1, "wait": "2s"},
                "request_timeout": "30s",
                "scale_down_after": "2m"
            }
        }
    ]
}
