{
    "__as": "page",
    "title": "{{ view.title || view.name }}",
    "aside": [
        {"__if": "view.phase === 'online'", "__as": "pill", "class": "running", "body": "online"},
        {"__if": "view.phase === 'greeting'", "__as": "pill", "class": "starting", "body": "connecting"},
        {"__if": "view.phase !== 'online' && view.phase !== 'greeting'", "__as": "pill", "class": "failed", "body": "offline"}
    ],
    "summary:dots": [
        "remote `{{ view.name }}`",
        {"__if": "view.phase === 'online' && view.uptime_ms !== null", "body": "connected {{ format_ms(view.uptime_ms) }} ago{{ view.address ? ' from ' + view.address : '' }}"},
        {"__if": "view.phase === 'online' && view.latency_ms !== null", "body": "delay {{ format_ms(view.latency_ms) }} · {{ format_bps(view.throughput_bps) }}"},
        {"__if": "view.phase !== 'online' && view.left_at", "body": "last seen {{ format_ms_ago(Date.now() - view.left_at) }}"},
        {"__for": "view.tags as tag", "class": "tag", "body": "#{{ tag }}{{ view.tags_declared.includes(tag) ? '*' : '' }}"}
    ],
    "body": [
        {
            "__if": "view.machine === null",
            "__as": "alert",
            "body": [
                "This machine has not connected since serviceman last started, so nothing is known about it yet. A running agent dials in by itself; a machine without one needs it: ",
                {"__as": "tablink", "tab": "install", "body": "Install the agent →"}
            ]
        },
        {
            "__if": "view.machine !== null && view.phase !== 'online'",
            "__as": "alert",
            "body": "The agent on this machine is not connected. What is below is what it last said."
        },
        {
            "__if": "view.error !== null",
            "__as": "alert",
            "body": "**Last error** · {{ view.error }}"
        },
        {
            "__if": "view.machine !== null",
            "__as": "tiles",
            "body": [
                {
                    "icon": "cpu",
                    "label": "CPU",
                    "body": "{{ view.machine.cpu_busy === null ? '—' : Math.round(view.machine.cpu_busy * 100) + '%' }}",
                    "value": "view.machine.cpu_busy === null ? 0 : view.machine.cpu_busy",
                    "note": "{{ view.machine.load === null ? '' : 'load ' + view.machine.load.toFixed(2) + ' · ' }}{{ view.machine.cpu.count }} × {{ view.machine.cpu.model }}"
                },
                {
                    "icon": "memory",
                    "label": "Memory",
                    "body": "{{ view.machine.mem.free === null ? '—' : Math.round((1 - view.machine.mem.free / view.machine.mem.total) * 100) + '%' }}",
                    "value": "view.machine.mem.free === null ? 0 : 1 - view.machine.mem.free / view.machine.mem.total",
                    "note": "{{ view.machine.mem.free === null ? '' : format_bytes(view.machine.mem.free) + ' free of ' }}{{ format_bytes(view.machine.mem.total) }}"
                },
                {
                    "icon": "database",
                    "label": "Disk",
                    "body": "{{ Math.round((1 - view.machine.disk.free / view.machine.disk.total) * 100) }}%",
                    "value": "1 - view.machine.disk.free / view.machine.disk.total",
                    "note": "{{ format_bytes(view.machine.disk.free) }} free of {{ format_bytes(view.machine.disk.total) }} on {{ view.machine.disk.path }}"
                },
                {
                    "__if": "view.machine.temperature !== null",
                    "icon": "thermometer",
                    "label": "Temperature",
                    "body": "{{ view.machine.temperature.c }}°C",
                    "value": "view.machine.temperature.c / 100",
                    "note": "{{ view.machine.temperature.of }}"
                },
                {
                    "__if": "view.machine.battery !== null",
                    "icon": "battery",
                    "label": "Battery",
                    "body": "{{ view.machine.battery.percent }}%",
                    "note": "{{ view.machine.battery.status }}"
                },
                {
                    "__if": "view.phase === 'online'",
                    "icon": "link",
                    "label": "Link",
                    "body": "{{ view.latency_ms === null ? '—' : format_ms(view.latency_ms) }}",
                    "note": "{{ view.throughput_bps === null ? 'not measured yet' : format_bps(view.throughput_bps) }}"
                }
            ]
        },
        {
            "__if": "view.machine !== null",
            "__as": "charts"
        },
        {
            "__as": "cards",
            "body": [
                {
                    "__if": "view.machine !== null",
                    "icon": "monitor",
                    "title": "Machine",
                    "aside": "{{ view.machine.hostname }}",
                    "body": [
                        {"label": "System", "body": "{{ view.machine.os || view.machine.platform }}"},
                        {"__if": "view.machine.os", "label": "Kernel", "body": "{{ view.machine.platform }} · {{ view.machine.arch }}"},
                        {"__if": "!view.machine.os", "label": "Arch", "body": "{{ view.machine.arch }}"},
                        {"__if": "view.machine.uptime_ms !== null", "label": "Up", "body": "{{ format_ms(view.machine.uptime_ms) }}"},
                        {"__if": "view.machine.addresses && view.machine.addresses.length > 0", "label": "Addresses", "body:dots": [{"__for": "view.machine.addresses as address", "body": "`{{ address }}`"}]},
                        {
                            "label": "Docker",
                            "body": [
                                {"__if": "view.machine.docker !== null", "body": "{{ view.machine.docker }}"},
                                {"__if": "view.machine.docker === null", "__as": "bad", "body": "none — a service on it cannot start"}
                            ]
                        }
                    ]
                },
                {
                    "__if": "view.machine !== null",
                    "icon": "robot",
                    "title": "Agent",
                    "aside": [
                        "{{ view.agent_version }} ",
                        {"__if": "agent_current(view, served) === true", "__as": "pill", "class": "running", "body": "up to date"},
                        {"__if": "agent_current(view, served) === false", "__as": "pill", "class": "starting", "body": "outdated"}
                    ],
                    "tab": "configure",
                    "go": "Configure",
                    "body": [
                        {"label": "Built", "body": "{{ view.agent_built === null ? 'before builds were dated' : view.agent_built }}"},
                        {"label": "Node", "body": "{{ view.machine.node }}"},
                        {"__if": "view.machine.user !== null", "label": "Runs as", "body": "{{ view.machine.user }}"},
                        {
                            "__if": "view.machine.can !== null",
                            "label": "Root half",
                            "body": [
                                {"__if": "view.machine.can.includes('root')", "body": "answers on this machine"},
                                {"__if": "view.machine.can.includes('root') === false", "__as": "muted", "body": "none — it does what its own user may do"}
                            ]
                        },
                        {"__if": "view.update_refused", "label": "Update", "class": "bad", "body": "refused: {{ view.update_refused }}"}
                    ]
                },
                {
                    "icon": "layers",
                    "title": "Services",
                    "class": "ov-list",
                    "aside": "{{ services.length === 0 ? 'none' : services.length }}",
                    "note": {"__if": "services.length === 0", "__as": "muted", "body": "No service uses this machine."},
                    "body": [
                        {
                            "__for": "services as item",
                            "body": {
                                "__as": "field",
                                "label": {"__as": "service", "name": "item.name", "body": "{{ item.title || item.name }}"},
                                "body": {"__as": "pill", "class": "{{ item.phase }}", "body": "{{ item.phase }}"}
                            }
                        }
                    ]
                },
                {
                    "__if": "view.machine !== null && view.machine.updates !== null",
                    "icon": "download",
                    "title": "Updates",
                    "aside": [
                        {"__if": "view.machine.updates.pending === 0", "__as": "pill", "class": "running", "body": "up to date"},
                        {"__if": "view.machine.updates.pending > 0 && view.machine.updates.security === 0", "__as": "pill", "class": "starting", "body": "{{ view.machine.updates.pending }} to install"},
                        {"__if": "view.machine.updates.pending > 0 && view.machine.updates.security > 0", "__as": "pill", "class": "failed", "body": "{{ view.machine.updates.security }} security"}
                    ],
                    "tab": "configure",
                    "go": "Configure",
                    "body": [
                        {"label": "Waiting", "body": "{{ view.machine.updates.pending === null ? 'unknown' : (view.machine.updates.pending === 0 ? 'nothing' : view.machine.updates.pending + (view.machine.updates.security > 0 ? ', ' + view.machine.updates.security + ' of them security' : '')) }}"},
                        {"__if": "view.machine.updates.reboot", "label": "Restart", "body": {"__as": "bad", "body": "an installed update wants one"}}
                    ]
                },
                {
                    "__if": "view.logline",
                    "icon": "file",
                    "title": "Logs",
                    "aside": [
                        {"__if": "view.logline.logs === 'all'", "__as": "pill", "class": "running", "body": "sent to Logline"},
                        {"__if": "view.logline.logs !== 'all'", "__as": "pill", "body": "off"}
                    ],
                    "tab": "logs",
                    "go": "Logs",
                    "note": {"__if": "view.logline.logs !== 'all'", "__as": "muted", "body": "This machine's logs stay on it."},
                    "body": [
                        {"__if": "view.logline.logs === 'all' && view.logline.status", "label": "Sent", "body": "{{ view.logline.status.sent.lines.toLocaleString() }} lines"},
                        {"__if": "view.logline.logs === 'all' && view.logline.status", "label": "Waiting", "body": "{{ view.logline.status.waiting.lines.toLocaleString() }} lines"},
                        {"__if": "view.logline.logs === 'all' && view.logline.error", "label": "Error", "class": "bad", "body": "{{ view.logline.error }}"},
                        {"__if": "logline_url", "label": "Viewer", "body": {"__as": "link", "href": "logline_url", "body": "its lines, the last 24 hours ↗"}}
                    ]
                }
            ]
        },
        {
            "__as": "details",
            "key": "raw",
            "label": "Raw state",
            "copy": "JSON.stringify(view, null, 2)",
            "body": {"__as": "pre", "body": "{{ JSON.stringify(view, null, 2) }}"}
        }
    ]
}
