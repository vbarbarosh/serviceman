# The environment serviceman reads. Nothing loads this file — it documents the keys.

# The host
SERVICEMAN_CONFIG=serviceman.json
SERVICEMAN_STATE_DIR=data
SERVICEMAN_LOG_DIR=
# SERVICEMAN_LOG_TIME=off leaves the time off stdout, for a runtime that stamps every line
SERVICEMAN_LOG_TIME=

# The agent on a remote machine (each also answers to --url, --token, --machine, --tags)
SERVICEMAN_URL=
SERVICEMAN_TOKEN=
SERVICEMAN_MACHINE=
SERVICEMAN_TAGS=

# Also read, by tests and by the agent's own halves: SERVICEMAN_AGENT_BUILT SERVICEMAN_AGENT_DIR
# SERVICEMAN_APT SERVICEMAN_BEAT_MS SERVICEMAN_DIR SERVICEMAN_DOCKER
# SERVICEMAN_REASON SERVICEMAN_ROLE SERVICEMAN_ROOT_FOR SERVICEMAN_ROOT_SOCKET
# SERVICEMAN_ROOT_SUPERVISED SERVICEMAN_SCREENSHOT SERVICEMAN_SECRETS SERVICEMAN_SERVICES_DIR
# SERVICEMAN_STATS_MS
