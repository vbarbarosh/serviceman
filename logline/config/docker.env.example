# Copy this file to .env beside docker-compose.yml.
# Run: docker info --format '{{.DockerRootDir}}'
DOCKER_ROOT_DIR=/var/lib/docker

# Usually /var/run/docker.sock. Rootless Docker commonly uses
# /run/user/<uid>/docker.sock.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# The lines endpoint (lines/). This machine's tailnet address, from `tailscale ip -4`: port
# 3000 is opened on it and nowhere else.
TAILSCALE_IP=100.64.0.20

# What serviceman shows to issue and revoke the tokens machines send lines with. The same value
# goes into serviceman's Secrets library. Make it once: openssl rand -hex 32
ADMIN_TOKEN=

# Where serviceman asks for tokens from: its tailnet address, comma-separated if there are more
ADMIN_IPS=100.64.0.5
