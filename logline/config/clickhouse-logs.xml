<clickhouse>
    <!-- ClickHouse's own logs, mounted as config.d/logs.xml: the ones nothing here reads are
         off, and the rest keep three days, where they kept everything and outgrew the lines
         twenty times over. A log whose definition changes is kept by ClickHouse as <name>_0 and
         written no more; a log turned off keeps its table: README says how to drop both. -->
    <trace_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_views_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </part_log>
    <metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </asynchronous_metric_log>
</clickhouse>
